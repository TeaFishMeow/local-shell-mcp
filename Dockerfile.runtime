ARG BUN_VERSION=1.3.14
FROM oven/bun:${BUN_VERSION} AS ui-builder
WORKDIR /source
COPY ui /source/ui
COPY src/local_shell_mcp /source/src/local_shell_mcp
RUN cd /source/ui && bun install --frozen-lockfile && bun run build

# Reuse the project's published full toolchain image, then replace the packaged
# application and UI with this local v4 working tree. This avoids downloading the
# multi-gigabyte Ubuntu toolchain again for local source deployments.
FROM fwerkor/local-shell-mcp:latest

USER root
WORKDIR /app

RUN set -eux; \
    helper_arch="$(uname -m)"; \
    install -d /tmp/local-shell-mcp-helper; \
    cp "/app/src/local_shell_mcp/helpers/linux-${helper_arch}/tmux" \
       /tmp/local-shell-mcp-helper/tmux; \
    rm -rf /app/src/local_shell_mcp

COPY pyproject.toml hatch_build.py README.md LICENSE /app/
COPY src/local_shell_mcp /app/src/local_shell_mcp
COPY --from=ui-builder /source/src/local_shell_mcp/ui_static /app/src/local_shell_mcp/ui_static
COPY --from=ui-builder /source/ui/dist/local-shell-mcp-tui /usr/local/bin/local-shell-mcp-tui

RUN set -eux; \
    helper_arch="$(uname -m)"; \
    install -d "/app/src/local_shell_mcp/helpers/linux-${helper_arch}"; \
    install -m 0755 /tmp/local-shell-mcp-helper/tmux \
      "/app/src/local_shell_mcp/helpers/linux-${helper_arch}/tmux"; \
    rm -rf /tmp/local-shell-mcp-helper; \
    pip install --no-cache-dir 'hatchling>=1.24' 'editables>=0.5'; \
    pip install --no-cache-dir --no-deps --no-build-isolation -e /app; \
    chmod 0755 /usr/local/bin/local-shell-mcp-tui; \
    python3 -c "import importlib.metadata as m; assert m.version('local-shell-mcp') == '4.0.0'"; \
    /usr/local/bin/local-shell-mcp-tui --version

COPY scripts/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN sed -i 's/\r$//' /usr/local/bin/docker-entrypoint.sh \
    && chmod 0755 /usr/local/bin/docker-entrypoint.sh \
    && chown -R agent:agent /app

WORKDIR /workspace
ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["local-shell-mcp", "--mode", "mcp"]
